# Headless Android 16 emulator for smoke-testing the APK. The google_apis x86_64 image
# translates arm64 binaries, which is how the arm64-only mosh-client runs on it.
FROM pocketshell-toolchain
# The emulator links X11/GL libraries even when run with -no-window.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libx11-6 libxext6 libxrender1 libxcomposite1 libxcursor1 libxi6 libxtst6 libxdamage1 libxrandr2 \
      libxkbfile1 libxfixes3 libnss3 libgl1 libegl1 libpulse0 libdbus-1-3 libasound2 libxcb1 libxcb-cursor0 \
      libxkbcommon0 libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*
RUN sdkmanager "emulator" "system-images;android-36;google_apis;x86_64" >/dev/null \
    && echo no | avdmanager create avd -n test -k "system-images;android-36;google_apis;x86_64" -d pixel_6 >/dev/null \
    && cfg=$(find / -path '*avd/test.avd/config.ini' 2>/dev/null | head -1) \
    && sed -i '/^hw.lcd.\(width\|height\|density\)=/d; /^skin\./d' "$cfg" \
    && printf 'hw.lcd.width=1080\nhw.lcd.height=2160\nhw.lcd.density=420\nskin.dynamic=yes\nhw.keyboard=no\n' >> "$cfg"
# 1080x2160: Play's phone screenshots may be no taller than twice their width, which a Pixel 6 (2400) is.
ENV PATH=$PATH:/opt/android-sdk/emulator
