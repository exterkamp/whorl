# The toolchain plus what running the desktop app needs on Linux: a virtual display, fonts and X libraries for
# Skia, mosh-client (the Linux build uses the system one), and tools to drive and screenshot the window.
FROM pocketshell-toolchain
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xvfb xdotool xclip imagemagick mosh fonts-dejavu-core \
      libxrender1 libxtst6 libxi6 libxrandr2 libgl1 libglu1-mesa libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*
