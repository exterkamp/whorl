<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Whorl" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The app draws its own dark mode; a phone that force-darkens apps would darken backgrounds but not text. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
